# --- Rust / Cargo ---------------------------------------------------------
# Build output. Cargo.lock is deliberately NOT ignored: this repo ships binaries,
# and a lockfile makes their builds reproducible.
debug
target

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# cargo mutants
**/mutants.out*/

# rustc dumps stack traces here on an internal compiler error
rustc-ice-*.txt

# Coverage / profiling output
*.profraw
*.profdata
/coverage/
lcov.info

# --- Secrets & local config -------------------------------------------------
# Nothing in this repo needs credentials; if a tool ever does, they live outside the tree.
.env
.env.*
!.env.example
*.pem
*.key

# --- Editors & OS -----------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# --- AI tooling: per-user state, never shared config ---------------------------
.claude/settings.local.json
.claude/worktrees/

# --- Scratch -------------------------------------------------------------------
*.tmp
*.log

# --- Generated release notices (cargo-about; see about.toml) ----------------------
THIRD-PARTY-LICENSES.md
